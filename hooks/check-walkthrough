#!/usr/bin/env bash
# check-walkthrough: a finished feature needs an owner walkthrough. When
# every item of a feature file (docs/features/*.md, from the ai-workflow
# templates/feature.md) is at Level `functional`, its Walkthrough: line
# must hold one of:
#
#   Walkthrough: done YYYY-MM-DD at <commit>
#       the owner watched it work, at that commit (its SHA)
#   Walkthrough: skipped YYYY-MM-DD at <commit>: <reason>
#       no walkthrough, and why; the commit is the one whose items the
#       owner decided not to watch
#
# Either one is stale, and fails, when an item has a higher Rev than it
# had at that commit, or did not exist then: what was watched, or
# skipped, is no longer what ships. Walk it again, or record a new skip.
# A skip in the old form, 'skipped: <reason>' without a date and commit,
# fails. A file whose items are not all functional passes whatever its
# Walkthrough: line says; a file without an item table passes with a
# note.
#
# A Level must be exists, substantive, wired or functional (backticks,
# asterisks and case aside), or empty or a dash while the item is not
# traced: any other value fails, since reading it as "not finished"
# would let a finished feature through. For the same reason a row of an
# item table without an item ID (F<n>-<n>) and a Rev from 1 fails: an
# empty row, a dropped item, the template's placeholder row. Tables are
# read as GitHub Markdown reads them (the outer pipes are optional), and
# a line that looks like an item row outside an item table fails.
#
# Usage: check-walkthrough [<commit>]
#
# Checks docs/features/ at the top of the repository it runs in: as
# committed in <commit> (the pre-push hook passes the tip of each ref it
# pushes to the default branch), or else as in the working tree. Without
# docs/features/ there is nothing to check.
#
# Exit status: 0 every finished feature has a walkthrough, 1 a check
# failed (each is named on stderr with its file), 2 bad usage or input
# that cannot be read.
#
# Source: https://github.com/Tonttu84/ai-workflow (MIT). Install with
# hooks/install.sh from that repo. Needs bash 3.2 or later and git.
set -eu

die() { echo "check-walkthrough: $*" >&2; exit 2; }
usage() { echo "usage: check-walkthrough [<commit>]" >&2; exit 2; }
case ${1:-} in
  -h | --help) awk 'NR > 1 && /^#/ { sub(/^# ?/, ""); print; next } NR > 1 { exit }' "$0"; exit 0 ;;
  -*) usage ;;
esac
[ "$#" -le 1 ] || usage

top=$(git rev-parse --show-toplevel 2> /dev/null) || die "not inside a git working tree"
cd "$top"
rev=
if [ "$#" -eq 1 ]; then
  rev=$(git rev-parse -q --verify "$1^{commit}" 2> /dev/null) || die "$1 is not a commit"
fi

DONE_FORM="'Walkthrough: done YYYY-MM-DD at <commit>' (the commit watched)"
SKIP_FORM="'Walkthrough: skipped YYYY-MM-DD at <commit>: <reason>' (the commit whose items you skip)"
FORMS="$DONE_FORM or $SKIP_FORM"

# The feature files, as paths from the top of the repository.
files=()
if [ -n "$rev" ]; then
  # Listed twice: the loop below cannot see git fail, and a silent empty
  # list would pass.
  git ls-tree "$rev" -- docs/features/ > /dev/null || die "cannot list docs/features/ in $1"
  while IFS= read -r -d '' entry; do
    case ${entry%%$'\t'*} in *' blob '*) ;; *) continue ;; esac
    path=${entry#*$'\t'}
    case $path in *.md) files+=("$path") ;; esac
  done < <(git ls-tree -z "$rev" -- docs/features/)
elif [ -d docs/features ]; then
  # Dot-named files too, as git ls-tree above and the other checks list
  # them.
  for path in docs/features/*.md docs/features/.*.md; do
    if [ -f "$path" ]; then files+=("$path"); fi
  done
fi
[ "${#files[@]}" -gt 0 ] || exit 0

# read_file <path>: the file as committed in $rev, or in the working tree
read_file() {
  if [ -n "$rev" ]; then git show "$rev:$1"; else cat -- "$1"; fi
}

# The table parser, scripts/feature-tables.awk from the same repository
# word for word (a test checks it): its header says what it prints.
# SC2016: this is awk code, expanded by awk, not by the shell.
# shellcheck disable=SC2016
# BEGIN feature-tables.awk
parse='
# feature-tables.awk: reads one feature file (templates/feature.md) and
# prints one tab-separated record per thing found, with its line number:
#
#   T <line> <Level column> <Test column>   an item table header (0 when
#                                           the column is missing)
#   I <line> <ID> <Rev> <Level> <Test>      an item row; cells trimmed, as
#                                           written
#   X <line> <message>                      a row that cannot be read
#   W <line> <value>                        a Walkthrough: line, trimmed
#   L <line> <value>                        a Locked tests: line, trimmed
#   K <line> <text>                         a line that looks like a Locked
#                                           tests: line (any case, any
#                                           Markdown decoration) but does
#                                           not start with exactly that;
#                                           text trimmed
#
# A table is a header row and a delimiter row with the same number of
# cells, as in GitHub Markdown; the outer pipes are optional. Its rows are
# the lines after it that hold a "|", up to the first line that does not.
# "\|" in a cell is not a column break. An item table is one whose first
# two header cells are ID and Rev. A line that looks like an item row
# (its first cell is F<n>-<n>) anywhere else is an X: in another table,
# in pipe lines that are not a table, or right after a table without its
# pipes.
# The same text is in hooks/check-walkthrough, between its BEGIN and END
# feature-tables.awk lines; tests/check-walkthrough.test.sh checks that
# the two match.
function trim(s) { sub(/^[ \t]+/, "", s); sub(/[ \t]+$/, "", s); return s }
# cells(row): splits a row into cell[1..n] and returns n
function cells(row,    n, i, part) {
  split("", cell)
  gsub(/\\\|/, "\001", row)
  sub(/^[ \t]*\|/, "", row)
  sub(/\|[ \t]*$/, "", row)
  n = split(row, part, "|")
  for (i = 1; i <= n; i++) {
    gsub(/\001/, "|", part[i])
    gsub(/\t/, " ", part[i])
    cell[i] = trim(part[i])
  }
  return n
}
function delimiter(n,    i) {
  for (i = 1; i <= n; i++) if (cell[i] !~ /^:?-+:?$/) return 0
  return n > 0
}
function piped(s) { gsub(/\\\|/, "", s); return index(s, "|") > 0 }
function itemlike(s) { return s ~ /^F[0-9]+-[0-9]+$/ }
# loose(nr, text): a pipe line outside any table
function loose(nr, text) {
  cells(text)
  if (itemlike(cell[1]))
    printf "X\t%d\t\"%s\" looks like an item row, but it is not in an item table (a header with ID and Rev first, then a delimiter row)\n", nr, cell[1]
}
FNR == 1 { intable = 0; pending = 0 }
{ sub(/\r$/, "") }
/^Walkthrough:/ { v = $0; sub(/^Walkthrough:/, "", v); printf "W\t%d\t%s\n", FNR, trim(v) }
/^Locked tests:/ { v = $0; sub(/^Locked tests:/, "", v); printf "L\t%d\t%s\n", FNR, trim(v) }
!/^Locked tests:/ && tolower($0) ~ /^[ \t>*+-]*([0-9]+[.)][ \t]*)?[*_`~ \t]*locked[ \t_-]*tests?[*_`~ \t]*:/ { printf "K\t%d\t%s\n", FNR, trim($0) }
intable && $0 ~ /^[ \t]*$/ { intable = 0; next }
intable && piped($0) {
  n = cells($0)
  if (!items) {
    if (itemlike(cell[1]))
      printf "X\t%d\t\"%s\" looks like an item row, but its table is not an item table (ID and Rev must be its first two columns)\n", FNR, cell[1]
    next
  }
  lv = (level && level <= n) ? cell[level] : ""
  ts = (testcol && testcol <= n) ? cell[testcol] : ""
  printf "I\t%d\t%s\t%s\t%s\t%s\n", FNR, cell[1], cell[2], lv, ts
  next
}
intable {
  intable = 0
  if (match(trim($0), /^F[0-9]+-[0-9]+/) && substr(trim($0), RLENGTH + 1, 1) !~ /[A-Za-z0-9-]/)
    printf "X\t%d\t\"%s\" right after a table is a row of it without pipes: write it with its pipes\n", FNR, trim($0)
}
!intable && piped($0) {
  n = cells($0)
  if (pending && delimiter(n) && n == headn) {
    pending = 0
    intable = 1
    cells(header)
    items = cell[1] == "ID" && cell[2] == "Rev"
    level = 0
    testcol = 0
    named = 0
    for (i = 1; i <= headn; i++) {
      if (i > 2 && cell[i] == "Level" && !level) level = i
      if (i > 2 && cell[i] == "Test" && !testcol) testcol = i
      if (cell[i] == "Item") named = 1
    }
    if (items) printf "T\t%d\t%d\t%d\n", headnr, level, testcol
    else if (named) printf "X\t%d\ta feature table with an Item column needs ID and Rev as its first columns\n", headnr
    next
  }
  if (pending) loose(headnr, header)
  pending = 1
  header = $0
  headnr = FNR
  headn = cells($0)
  next
}
{ if (pending) loose(headnr, header); pending = 0 }
END { if (pending) loose(headnr, header) }
'
# END feature-tables.awk

# The parser's records summed up for one feature file:
#   I<TAB>id<TAB>rev<TAB>level<TAB>line   per item row (level lower case,
#                                         without backticks or asterisks)
#   B<TAB>message                         per row that cannot be read, per
#                                         row of an item table that is not
#                                         an item (a bad ID or Rev), and
#                                         per Level that is not a level
#   S<TAB>items<TAB>not functional<TAB>Walkthrough: lines<TAB>line of an
#     item table without a Level column (0 if none)
#   V<TAB>value of the first Walkthrough: line
# A Level is one of exists, substantive, wired and functional, or empty
# or a dash while the item is not traced; any other value is a problem,
# never "not finished", which would let a finished feature through.
# shellcheck disable=SC2016
summarize='
  function norm(s) { gsub(/[`*]/, "", s); s = tolower(s); sub(/^[ \t]+/, "", s); sub(/[ \t]+$/, "", s); return s }
  $1 == "X" { printf "B\tline %d: %s\n", $2, $3 }
  $1 == "T" && $3 == 0 && !nolevel { nolevel = $2 }
  $1 == "W" && ++walks == 1 { walk = $3 }
  $1 == "I" {
    lv = norm($5)
    if ($3 !~ /^F[1-9][0-9]*-[1-9][0-9]*$/ || $4 !~ /^[1-9][0-9]*$/)
      printf "B\tline %d: the row with ID \"%s\" and Rev \"%s\" is not an item: an item table row needs an ID F<feature>-<item> and a Rev from 1 (delete an empty or dropped row)\n", $2, $3, $4
    if (lv != "" && lv !~ /^(exists|substantive|wired|functional|-|—|–)$/)
      printf "B\tline %d: %s has Level \047%s\047, which is none of exists, substantive, wired and functional (leave it empty or write — while the item is not traced)\n", $2, $3, $5
    printf "I\t%s\t%s\t%s\t%d\n", $3, $4, lv, $2
    items++
    if (lv != "functional") open++
  }
  END {
    printf "S\t%d\t%d\t%d\t%d\n", items, open, walks, nolevel
    printf "V\t%s\n", walk
  }
'
# summary <text>: the summed-up records of a feature file's text
summary() { printf '%s\n' "$1" | awk "$parse" | awk -F '\t' "$summarize"; }

# record <kind> <parsed>: the parser's records of that kind, without it
record() { printf '%s\n' "$2" | awk -v k="$1" 'index($0, k "\t") == 1 { print substr($0, length(k) + 2) }'; }

status=0
# fail <file> <message>
fail() {
  printf 'check-walkthrough: %s: %s\n' "$1" "$2" >&2
  if [ "$status" -eq 0 ]; then status=1; fi
}

# valid_date <year> <month> <day>: a real calendar date
valid_date() {
  local max
  case $2 in
    1 | 3 | 5 | 7 | 8 | 10 | 12) max=31 ;;
    4 | 6 | 9 | 11) max=30 ;;
    2)
      if [ $(($1 % 4)) -eq 0 ] && { [ $(($1 % 100)) -ne 0 ] || [ $(($1 % 400)) -eq 0 ]; }; then
        max=29
      else
        max=28
      fi ;;
    *) return 1 ;;
  esac
  [ "$3" -ge 1 ] && [ "$3" -le "$max" ]
}

# stale_items <items then> <items now>: what changed since the commit
# watched: an item at a higher Rev, or one that was not there
stale_items() {
  { printf '%s\n' "$1" | awk '{ print "O\t" $0 }'; printf '%s\n' "$2" | awk '{ print "N\t" $0 }'; } |
    awk -F '\t' '
      $1 == "O" { if ($3 ~ /^[1-9][0-9]*$/ && (!($2 in old) || $3 + 0 > old[$2] + 0)) old[$2] = $3; next }
      $2 == "" { next }
      !($2 in old) { printf "%s%s was added", sep, $2; sep = "; "; next }
      $3 + 0 > old[$2] + 0 { printf "%s%s went from r%s to r%s", sep, $2, old[$2], $3; sep = "; " }
    '
}

# check_record <file> <items now> <value>: a done walkthrough or a skip
# names a real date and commit (a skip also a reason), and no item
# changed since that commit
check_record() {
  local file=$1 items=$2 value=$3 when re what reason y m d sha full bad old stale again
  when='([0-9]{4})-([0-9]{2})-([0-9]{2})[[:blank:]]+at[[:blank:]]+([0-9a-f]{7,64})'
  re="^done[[:blank:]]+$when\$"
  if [[ $value =~ $re ]]; then
    what=walkthrough
  else
    re="^skipped[[:blank:]]+${when}[[:blank:]]*:(.*)\$"
    if [[ $value =~ $re ]]; then
      what=skip
    elif [[ $value == skipped:* ]]; then
      fail "$file" "the skip '$value' is in the old form, without a date and commit: write $SKIP_FORM"
      return 0
    else
      fail "$file" "the walkthrough '$value' is in neither form: write $FORMS"
      return 0
    fi
  fi
  y=$((10#${BASH_REMATCH[1]}))
  m=$((10#${BASH_REMATCH[2]}))
  d=$((10#${BASH_REMATCH[3]}))
  sha=${BASH_REMATCH[4]}
  if [ "$what" = skip ]; then
    reason=${BASH_REMATCH[5]}
    reason=${reason#"${reason%%[![:blank:]]*}"}
    re='^<[^>]*>$'
    if [ -z "$reason" ] || [[ $reason =~ $re ]]; then
      fail "$file" "a skipped walkthrough needs a written reason: $SKIP_FORM"
      return 0
    fi
  fi
  if ! valid_date "$y" "$m" "$d"; then
    fail "$file" "the $what date in '$value' is not a real date"
    return 0
  fi
  if ! full=$(git rev-parse -q --verify "$sha^{commit}" 2> /dev/null); then
    fail "$file" "the $what names commit $sha, which is not found in this repository (or is not a commit, or the short SHA is ambiguous)"
    return 0
  fi
  bad=$(printf '%s\n' "$items" | awk -F '\t' '$1 !~ /^F[1-9][0-9]*-[1-9][0-9]*$/ || $2 !~ /^[1-9][0-9]*$/ {
    printf "%sline %s: ID \"%s\", Rev \"%s\"", sep, $4, $1, $2; sep = "; " }')
  if [ -n "$bad" ]; then
    fail "$file" "an item has a bad ID or Rev ($bad), so it cannot be compared with commit $sha"
    return 0
  fi
  again="Walk it again and write $DONE_FORM, or record a new skip: $SKIP_FORM"
  if ! git cat-file -e "$full:$file" 2> /dev/null; then
    fail "$file" "the $what is stale: the file did not exist at $sha, the commit it names. $again"
    return 0
  fi
  if ! old=$(git show "$full:$file"); then
    echo "check-walkthrough: $file: cannot read it at $sha" >&2
    status=2
    return 0
  fi
  stale=$(stale_items "$(record I "$(summary "$old")")" "$items")
  if [ -n "$stale" ]; then
    fail "$file" "the $what at $sha is stale; since then $stale. $again"
  fi
}

# check_file <path>
check_file() {
  local file=$1 text parsed nitems open walks nolevel value problems problem
  if ! text=$(read_file "$file"); then
    echo "check-walkthrough: $file: cannot read it" >&2
    status=2
    return 0
  fi
  parsed=$(summary "$text")
  IFS=$'\t' read -r nitems open walks nolevel <<< "$(record S "$parsed")"
  problems=$(record B "$parsed")
  if [ -n "$problems" ]; then
    while IFS= read -r problem; do fail "$file" "$problem"; done <<< "$problems"
    return 0
  fi
  if [ "$nolevel" -ne 0 ]; then
    fail "$file" "line $nolevel: an item table without a Level column, so whether the feature is finished cannot be told"
    return 0
  fi
  if [ "$nitems" -eq 0 ]; then
    echo "check-walkthrough: note: $file has no item table; nothing to check" >&2
    return 0
  fi
  if [ "$open" -ne 0 ]; then return 0; fi # not finished yet
  if [ "$walks" -eq 0 ]; then
    fail "$file" "every item is functional and there is no Walkthrough: line: watch the feature work, then write $FORMS"
    return 0
  fi
  if [ "$walks" -gt 1 ]; then
    fail "$file" "there is more than one Walkthrough: line ($walks); keep one"
    return 0
  fi
  value=$(record V "$parsed")
  if [ -z "$value" ]; then
    fail "$file" "every item is functional and the walkthrough is not recorded: watch the feature work, then write $FORMS"
    return 0
  fi
  check_record "$file" "$(record I "$parsed")" "$value"
}

for file in "${files[@]}"; do
  check_file "$file"
done
exit "$status"
